# ===========================================
# Novatech Website - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# ===========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Admin Authentication ---
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=your-random-session-secret
NEXT_PUBLIC_MAIN_SITE_URL=https://novatechmachinery.in

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Your Company Name
SMTP_TO_EMAIL=your-email@gmail.com
SMTP_SECURE=false
# --- CRM Enquiry Sync (server-to-server, optional) ---
CRM_ENQUIRY_ENDPOINT=https://your-crm-domain.com/api/enquiries
CRM_ENQUIRY_SECRET=your-long-random-shared-secret
CRM_ENQUIRY_ASSIGNED_TO=Jagmeet
CRM_ENQUIRY_LEAD_CATEGORY=End User
CRM_ENQUIRY_TIMEOUT_MS=8000
